APP_NAME=AgriSense AI API
ENV=development
DEBUG=false

# Required (32+ chars) when ENV is not development.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Leave DATABASE_URL empty to use DB_* (MySQL) when DB_HOST is set, or SQLite when it is not.
# Example: DATABASE_URL=mysql+pymysql://agrisense:PASSWORD@localhost:3306/agrisense_db
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=agrisense
DB_PASSWORD=agrisense
DB_NAME=agrisense_db

CORS_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_PER_MINUTE=60
INFERENCE_RATE_LIMIT_PER_MINUTE=20

INFERENCE_SERVICE_URL=http://localhost:8001
# Optional shared secret, must match the inference service (recommended outside local dev)
INFERENCE_API_KEY=
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
LLM_API_KEY=

API_PUBLIC_URL=http://localhost:8000
# Only for Docker (set by docker-compose.yml). Leave empty for a normal local run.
INTERNAL_API_URL=
OFFICER_SIGNUP_CODE=
